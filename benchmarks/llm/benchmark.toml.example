# Copy to benchmark.toml and fill in. benchmark.toml is gitignored.

[minuspod]
base_url = "https://podsrv.example.com"
password_env = "MINUSPOD_PASSWORD"
session_cache_path = "~/.cache/minuspod-benchmark/session.json"

[providers.openrouter]
client = "openai_compatible"
base_url = "https://openrouter.ai/api/v1"
api_key_env = "OPENROUTER_API_KEY"

[providers.anthropic_direct]
client = "anthropic"
api_key_env = "ANTHROPIC_API_KEY"

# --- Models ---
# Roster refreshed 2026-08-03, extended 2026-08-12. Slugs verified against
# the live OpenRouter catalog (GET /api/v1/models) and the current Anthropic
# model list.

